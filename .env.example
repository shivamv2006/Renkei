# ==============================================================================
# GENZOKU — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   copy .env.example .env.local
#
# Replace the placeholder values below with your own independent Supabase project keys.
# ==============================================================================

# Supabase Project URL (From Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Publishable Key (Client safe with RLS policies enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT BROWSERS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME=Renkei
NEXT_PUBLIC_APP_URL=https://renkei.app
NEXT_PUBLIC_APP_TAGLINE="stay in sync • connect & coordinate"

# WebRTC STUN Servers (Comma separated STUN servers for direct NAT traversal)
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# WebRTC Secure TURN Relay Configuration (Optional - Needed for symmetric NAT / cellular / firewalled connections)
# You can obtain free TURN credentials from providers such as Metered.ca (free 50GB plan), Twilio, or self-hosted Coturn.
# NEVER commit real TURN credentials to Git. Add them only to your local .env.local file.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
